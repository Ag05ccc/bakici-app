[Unit]
Description=Building radio dashboard and report receiver
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/opt/bakici-app
ExecStart=/usr/bin/python3 -u /opt/bakici-app/web_app.py --mode server --config /etc/bakici/server.json --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bakici-server

[Install]
WantedBy=multi-user.target
